AGENT_DATABASE_URL=postgresql://postgres@localhost:5433/up_police_agent

# LLM provider — auto-detected from whichever key is set below.
# Override explicitly: nvidia | anthropic | gemini
# AGENT_LLM_PROVIDER=nvidia

# Override model (uses provider default when blank):
# AGENT_LLM_MODEL=meta/llama-3.1-70b-instruct   (NVIDIA NIM default)
# AGENT_LLM_MODEL=claude-sonnet-4-6                         (Anthropic default)
# AGENT_LLM_MODEL=gemini-3.1-pro                            (Gemini default)

# Required for the "nvidia" provider — the OpenAI-compatible NIM endpoint.
AGENT_LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Set exactly ONE provider key:
AGENT_NVIDIA_API_KEY=
AGENT_ANTHROPIC_API_KEY=
AGENT_GEMINI_API_KEY=

# Where uploaded CSVs are persisted
AGENT_UPLOAD_DIR=./data/uploads

PORT=8001
